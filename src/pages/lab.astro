---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { site } from '../lib/data';

const process = [
  { title: 'Design', text: 'Every rocket starts with requirements. Using a systems engineering approach, the team works toward the cleanest, safest and most effective vehicle it can build.' },
  { title: 'Build', text: "AEDL's shops and the team's vehicle assembly bay, over 200 square feet of it, turn CAD into flight hardware." },
  { title: 'Verify', text: 'Before anything flies, major design elements like recovery systems are tested and adjusted at AEDL and at Kentland Farm.' },
  { title: 'Launch', text: 'Depending on the flight, a rocket launches next door at Kentland Farm or travels across the country to sites like Black Rock, Nevada.' },
];

const facilities = [
  { group: 'Spaces', items: ['Vehicle assembly bay', 'Machine shop', 'CAD lab', 'Conference room'] },
  { group: 'Equipment', items: ['4-axis filament winder', '3D printer', 'Band saw', 'Drill press', 'Power tools'] },
  { group: 'Supplies and safety', items: ['Fasteners', 'Epoxies', 'Safety infrastructure throughout'] },
];

const sites = [
  { name: 'Kentland Farm', place: 'Blacksburg, VA', note: 'Testing and most member flights' },
  { name: 'Tripoli Central Virginia', place: 'Rapidan, VA', note: 'Skipper 1' },
  { name: 'Rocket Pasture', place: 'Argonia, KS', note: 'Hokie 0.5' },
  { name: 'Black Rock Desert', place: 'Nevada', note: 'Hokie 0.5 sustainer' },
];
---
<Base title="The Lab" description="Where OLVT designs, builds and tests its rockets: the Advanced Engineering Design Lab at Virginia Tech.">
  <section class="wrap head">
    <h1>The Lab</h1>
    <p class="lead">OLVT designs, builds and tests its rockets in Virginia Tech's {site.lab.name} (AEDL).</p>
    <p><a href={site.lab.url} rel="noopener" target="_blank">About AEDL on the College of Engineering site</a></p>
  </section>

  <section class="wrap">
    <Photo needed="The vehicle assembly bay at AEDL, ideally with a rocket mid-build" ratio="21 / 9" />
  </section>

  <section class="section wrap">
    <h2 class="section-title">From requirements to the launch rail</h2>
    <ol class="steps">
      {process.map((p, i) => (
        <li>
          <span class="step-num tnum" aria-hidden="true">{i + 1}</span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section wrap two-col">
    <div>
      <h2 class="section-title">Facilities</h2>
      <div class="facilities">
        {facilities.map((f) => (
          <div>
            <h3 class="fac-head">{f.group}</h3>
            <ul>{f.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
    <div>
      <h2 class="section-title">Where we fly</h2>
      <dl class="specs">
        {sites.map((s) => (
          <div><dt>{s.name}<br /><span class="small">{s.place}</span></dt><dd>{s.note}</dd></div>
        ))}
      </dl>
    </div>
  </section>
</Base>

<style>
  .head { display: grid; gap: 1.25rem; padding-block: clamp(2.5rem, 6vw, 4.5rem) 2rem; }
  .section-title { font-size: var(--step-2); margin-bottom: 1.75rem; }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; }
  .steps li { display: grid; gap: 0.6rem; align-content: start; border-top: 2px solid var(--ink); padding-top: 1rem; }
  .step-num { font-stretch: 125%; font-variation-settings: "wdth" 125; font-weight: 800; font-size: var(--step-2); color: var(--mark-next); line-height: 1; }

  .two-col { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); }
  .facilities { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 1.5rem; }
  .fac-head { font-size: 1rem; font-stretch: 100%; font-variation-settings: "wdth" 100; color: var(--ink-muted); font-weight: 600; margin-bottom: 0.5rem; }
  .facilities ul { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.3rem; }

  @media (max-width: 900px) {
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .two-col { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .steps { grid-template-columns: 1fr; }
  }
</style>
